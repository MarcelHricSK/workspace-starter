# Normalise line endings: LF in the repository and in working trees.
* text=auto eol=lf

# Scripts that must keep a specific line ending to run.
*.sh  text eol=lf
*.py  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git hooks have no extension; keep them LF so the shebang works everywhere.
.githooks/* text eol=lf

# Binary formats: never diff or normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff  binary
*.woff2 binary
*.ttf  binary
